{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LJK Pro Scanner Firestore Schema",
  "description": "Schema definitions for exams, students, scan results, and configuration data.",
  "entities": {
    "exams": {
      "type": "object",
      "description": "Exam configurations with answer keys and weights",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "gradeClass": { "type": "string" },
        "teacherName": { "type": "string" },
        "totalQuestions": { "type": "number" },
        "optionsCount": { "type": "number" },
        "passingScore": { "type": "number" },
        "answerKey": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "weights": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "totalQuestions", "answerKey"]
    },
    "students": {
      "type": "object",
      "description": "Registered students roster",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "studentNo": { "type": "string" },
        "gradeClass": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "studentNo"]
    },
    "scan_results": {
      "type": "object",
      "description": "Exam grading results scanned via OMR Camera or ADF Scanner",
      "properties": {
        "id": { "type": "string" },
        "examId": { "type": "string" },
        "examTitle": { "type": "string" },
        "studentNo": { "type": "string" },
        "studentName": { "type": "string" },
        "score": { "type": "number" },
        "rawCorrect": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "isPassed": { "type": "boolean" },
        "answers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "itemCorrectness": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "processedAt": { "type": "string" },
        "source": { "type": "string" }
      },
      "required": ["id", "examId", "studentNo", "score"]
    },
    "app_meta": {
      "type": "object",
      "description": "Global teacher profile and scanner device configuration",
      "properties": {
        "id": { "type": "string" },
        "teacher": { "type": "object" },
        "kyocera": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    }
  }
}
