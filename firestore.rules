rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write for exam configs, student rosters, scan results, and meta settings
    match /exams/{examId} {
      allow read, write: if true;
    }
    match /students/{studentId} {
      allow read, write: if true;
    }
    match /scan_results/{resultId} {
      allow read, write: if true;
    }
    match /app_meta/{metaId} {
      allow read, write: if true;
    }
  }
}
